# Maintainer: TODO <support@ing-systems.com>
# Note: binary target is bzip3, package/library is bzip3-rs/bzip3_rs.
pkgname=bzip3-rs
pkgver=1.0.0
pkgrel=1
pkgdesc='Pure-Rust port of the bzip3 compressor'
arch=('x86_64')
url='https://github.com/ing-systems/bzip3-rs'
license=('LGPL-3.0-only' 'Apache-2.0')
depends=('glibc' 'gcc-libs')
makedepends=('cargo' 'git')
source=("$pkgname::git+https://github.com/ing-systems/bzip3-rs.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  CARGO_TARGET_DIR=target cargo build --frozen --release --features cli
}

check() {
  cd "$pkgname"
  CARGO_TARGET_DIR=target cargo test --frozen --features cli
}

package() {
  cd "$pkgname"
  # Binary target (bzip3) differs from package (bzip3-rs) / library (bzip3_rs).
  install -Dm755 target/release/bzip3 "$pkgdir/usr/bin/bzip3"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
  ln -s bzip3 "$pkgdir/usr/bin/bunzip3"
  ln -s bzip3 "$pkgdir/usr/bin/bz3cat"
  install -Dm755 scripts/bz3grep "$pkgdir/usr/bin/bz3grep"
  ln -s bz3grep "$pkgdir/usr/bin/bz3egrep"
  ln -s bz3grep "$pkgdir/usr/bin/bz3fgrep"
  install -Dm755 scripts/bz3more "$pkgdir/usr/bin/bz3more"
  ln -s bz3more "$pkgdir/usr/bin/bz3less"
  ln -s bz3more "$pkgdir/usr/bin/bz3most"
  install -Dm755 scripts/bz3diff "$pkgdir/usr/bin/bz3diff"
  ln -s bz3diff "$pkgdir/usr/bin/bz3cmp"
  install -Dm644 man/man1/bzip3.1 "$pkgdir/usr/share/man/man1/bzip3.1"
  install -Dm644 man/man1/bunzip3.1 "$pkgdir/usr/share/man/man1/bunzip3.1"
  install -Dm644 man/man1/bz3cat.1 "$pkgdir/usr/share/man/man1/bz3cat.1"
  install -Dm644 man/man1/bz3grep.1 "$pkgdir/usr/share/man/man1/bz3grep.1"
  install -Dm644 man/man1/bz3diff.1 "$pkgdir/usr/share/man/man1/bz3diff.1"
  install -Dm644 man/man1/bz3more.1 "$pkgdir/usr/share/man/man1/bz3more.1"
}
